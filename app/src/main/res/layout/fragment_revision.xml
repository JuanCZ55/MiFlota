<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.revision.RevisionFragment">

    <!-- CABECERA: Detalle vehiculo (Fijo arriba) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detalle_vehiculo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#1A1C1E"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPatente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Patente: N/A"
                android:textColor="@color/textSecondary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMarca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="N/A"
                android:textColor="@color/textSecondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detalle_vehiculo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="40dp">

            <!-- SECCIÓN: ILUMINACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ILUMINACIÓN"
                android:drawableStart="@drawable/ic_lightbulb"
                android:drawablePadding="8dp"
                android:textColor="@color/primary"
                app:drawableTint="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#1AFFFFFF" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swFaroDelanteroIzquierdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Faro Delantero Izq."
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swFaroDelanteroDerecho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Faro Delantero Der."
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swFaroTraseroIzquierdo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Faro Trasero Izq."
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swFaroTraseroDerecho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Faro Trasero Der."
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <!-- SECCIÓN: LÍQUIDOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="LÍQUIDOS"
                android:drawableStart="@drawable/ic_water_drop"
                android:drawablePadding="8dp"
                android:textColor="@color/primary"
                app:drawableTint="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#1AFFFFFF" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNivelAceite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Nivel de Aceite"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swLiquidoFrenos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Líquido de Frenos"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNivelRefrigerante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Nivel de Refrigerante"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNivelAguaParabrisa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Nivel de Agua Parabrisas"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <!-- SECCIÓN: SEGURIDAD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="SEGURIDAD"
                android:drawableStart="@drawable/ic_security"
                android:drawablePadding="8dp"
                android:textColor="@color/primary"
                app:drawableTint="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#1AFFFFFF" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swPresionNeumaticos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Presión de Neumáticos"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swNivelFreno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Estado de Frenos"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swMatafuegoVigente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Matafuego Vigente"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"/>

            <!-- SECCIÓN: OBSERVACIONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="OBSERVACIONES"
                android:drawableStart="@drawable/ic_observation"
                android:drawablePadding="8dp"
                android:textColor="@color/primary"
                app:drawableTint="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="#1AFFFFFF" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="#1A1C1E"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="Detalles adicionales..."
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:textColor="@color/textPrimary"

                    android:textColorHint="@color/textSecondary" />
            </com.google.android.material.textfield.TextInputLayout>


            <!-- SECCIÓN: ESTADO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="ESTADO"
                android:drawableStart="@drawable/ic_revisiones"
                android:drawablePadding="8dp"
                android:textColor="@color/primary"
                app:drawableTint="@color/primary"
                android:textStyle="bold"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#1AFFFFFF" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Estado"
                android:textColor="@color/textPrimary"
                app:thumbTint="@color/switch_thumb_tint"
                app:trackTint="@color/switch_track_tint"
                android:checked="true"
                />

            <!-- BOTÓN GUARDAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarRevision"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="REGISTRAR REVISION"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/textPrimary"
                app:cornerRadius="12dp" />

            <!-- BOTÓN ACTUALIZAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActualizarRevision"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="GUARDAR REVISION"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                android:textColor="@color/textPrimary"
                android:visibility="gone"
                app:cornerRadius="12dp" />



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>