<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.vehiculo.VehiculoFragment">

    <LinearLayout
        android:id="@+id/layoutForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- SECCIÓN: IDENTIFICACIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patente"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPatente"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:inputType="textCapCharacters"
            android:textColor="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marca"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:inputType="textCapWords"
            android:textColor="@color/textPrimary" />

        <!-- FILA: AÑO Y COLOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Año"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etAnio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary"
                    android:enabled="false"
                    android:inputType="number"
                    android:textColor="@color/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etColor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary"
                    android:enabled="false"
                    android:inputType="textCapWords"
                    android:textColor="@color/textPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN: SERIALES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de Chasis"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNumeroChasis"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:inputType="textCapCharacters"
            android:textColor="@color/textPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de Motor"
            android:textSize="14sp"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etNumeroMotor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:inputType="textCapCharacters"
            android:textColor="@color/textPrimary" />

        <!-- FILA: NEUMÁTICOS Y AUXILIOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cant. Neumáticos"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etCantNeumaticos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary"
                    android:enabled="false"
                    android:inputType="number"
                    android:textColor="@color/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cant. Auxilios"
                    android:textSize="14sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginBottom="4dp" />
                <EditText
                    android:id="@+id/etCantAuxilios"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary"
                    android:enabled="false"
                    android:inputType="number"
                    android:textColor="@color/textPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTÓN ACCIÓN -->
        <Button
            android:id="@+id/btnMatafuego"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Detalle del Matafuego"
            android:backgroundTint="@color/primary"
            android:textColor="@color/textPrimary"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
