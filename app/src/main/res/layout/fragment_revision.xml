<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA: Resumen del Reporte -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1C1E"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3394A3B8">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <TextView
                    android:id="@+id/labelId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="ID REPORTE"
                    android:textColor="@color/textSecondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvIdRevision"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#CH-0000"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/labelId" />


                <View
                    android:id="@+id/dividerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#1AFFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/tvIdRevision" />

                <TextView
                    android:id="@+id/tvDetalleFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:text="- -/- -/- - - -"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    app:drawableTint="@color/textSecondary"
                    app:layout_constraintBottom_toBottomOf="@id/tvIdRevision"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvIdRevision" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado"
                    android:textColor="@color/textPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/dividerHeader" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN: ILUMINACIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_lightbulb" app:tint="@color/primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="ILUMINACIÓN" android:textColor="@color/primary" android:textStyle="bold" android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1A1C1E"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="#3394A3B8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/listDivider"
                android:showDividers="middle">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swFaroDelanteroIzquierdo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Faro Delantero Izq."
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swFaroDelanteroDerecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Faro Delantero Der."
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swFaroTraseroIzquierdo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Faro Trasero Izq."
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swFaroTraseroDerecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHighlight="@color/primary"

                    android:padding="12dp"
                    android:text="Faro Trasero Der."
                    android:textColor="@color/textPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN: LÍQUIDOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_water_drop" app:tint="@color/primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="LÍQUIDOS" android:textColor="@color/primary" android:textStyle="bold" android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1A1C1E"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="#3394A3B8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/listDivider"
                android:showDividers="middle">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNivelAceite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Nivel de Aceite"
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swLiquidoFrenos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Líquido de Frenos"
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNivelRefrigerante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Nivel de Refrigerante"
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNivelAguaParabrisa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Nivel de Agua del Parabrisa"
                    android:textColor="@color/textPrimary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN: Seguridad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_security" app:tint="@color/primary" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="LÍQUIDOS" android:textColor="@color/primary" android:textStyle="bold" android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1A1C1E"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0.5dp"
            app:strokeColor="#3394A3B8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/listDivider"
                android:showDividers="middle">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swPresionNeumaticos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Pression de Neumaticos"
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swNivelFreno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Nivel de Frenos"
                    android:textColor="@color/textPrimary" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swMatafuegoVigente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="Matafuego Vigente"
                    android:textColor="@color/textPrimary" />



            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN: OBSERVACIONES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:text="OBSERVACIONES"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#1A1C1E"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Ingrese detalles de fallas..."
                android:minLines="3"
                android:textColor="@color/textPrimary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGuardarRevision"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/primary"
            android:text="GUARDAR CAMBIOS"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>