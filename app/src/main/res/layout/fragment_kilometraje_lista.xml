<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.kilometrajeLista.KilometrajeListaFragment"
    >

    <com.github.AAChartModel.AAChartCore.AAChartCreator.AAChartView
        android:id="@+id/grafico"
        android:layout_width="match_parent"
        android:layout_height="220dp"

        android:layout_margin="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"></com.github.AAChartModel.AAChartCore.AAChartCreator.AAChartView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRegistrosDekilometraje"
        android:layout_width="409dp"
        android:layout_height="653dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grafico" />

</androidx.constraintlayout.widget.ConstraintLayout>

